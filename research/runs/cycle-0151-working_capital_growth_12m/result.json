  "factor": {
    "name": "working_capital_growth_12m",
    "family": "working_capital_investment",
    "category": "other",
    "definition_hash": "3b7ad689dbdebc0a",
    "predicted_sign": -1,
    "params": {
      "lookback_months": 12
    },
    "rebalance_months": 3,
    "needs": [
      "current_assets",
      "current_liabilities"
    ],
    "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"], kind=\"mergesort\")\n    working_capital = ordered[\"current_assets\"] - ordered[\"current_liabilities\"]\n    prior = working_capital.groupby(ordered[\"asset_id\"], sort=False).shift(LOOKBACK_MONTHS)\n    prior_month = ordered.groupby(\"asset_id\", sort=False)[\"ym\"].shift(LOOKBACK_MONTHS)\n    value = working_capital / prior.where(prior > 0) - 1.0\n    return value.where(ordered[\"ym\"].eq(prior_month + LOOKBACK_MONTHS)).reindex(frame.index)\n"
  },
  "research_spec": {
    "thesis": "양의 순운전자본의 12개월 증가율이 높은 종목의 이후 순위가 낮을 것이다.",
