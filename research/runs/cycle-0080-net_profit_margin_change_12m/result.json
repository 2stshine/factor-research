    "rebalance_months": 3,
    "needs": [
      "net_income_ttm",
      "revenue_ttm"
    ],
    "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"])\n    asset = ordered[\"asset_id\"]\n    revenue = ordered[\"revenue_ttm\"].where(ordered[\"revenue_ttm\"] > 0)\n    current = ordered[\"net_income_ttm\"] / revenue\n    prior = current.groupby(asset).shift(LOOKBACK_MONTHS)\n    prior_ym = ordered[\"ym\"].groupby(asset).shift(LOOKBACK_MONTHS)\n    value = (current - prior).where(ordered[\"ym\"].eq(prior_ym + LOOKBACK_MONTHS))\n    return value.reindex(frame.index)\n"
  },
  "research_spec": {
    "thesis": "Silver PIT TTM 순이익률의 12개월 개선폭이 큰 종목은 다음 달 총수익률 순위가 높을 것이다.",
    "mechanism": "영업외손익과 세금까지 반영한 최종 마진 개선의 지속성이 후속 공시에 걸쳐 늦게 반영될 수 있다.",
    "falsification": "양의 방향과 자동 gate, campaign BY, 봉인 OOS, 귀무 보정 또는 기존 신호 직교성이 실패하면 기각한다.",
    "expected_relationship": "net_profit_margin 및 operating_margin_change_12m와 관련되지만 최종 순이익률의 변화만 측정한다.",
    "data_notes": "DART available_date PIT net_income_ttm과 양의 revenue_ttm을 사용하고 정확한 12개월 간격만 허용한다.",
