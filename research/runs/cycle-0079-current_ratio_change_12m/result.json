  "factor": {
    "name": "current_ratio_change_12m",
    "family": "short_term_solvency_change",
    "category": "quality",
    "definition_hash": "6b612f0530a1e066",
    "predicted_sign": 1,
    "params": {
      "lookback_months": 12
    },
    "rebalance_months": 3,
    "needs": [
      "current_assets",
      "current_liabilities"
    ],
    "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"])\n    asset = ordered[\"asset_id\"]\n    liabilities = ordered[\"current_liabilities\"].where(\n        ordered[\"current_liabilities\"] > 0\n    )\n    current = ordered[\"current_assets\"] / liabilities\n    prior = current.groupby(asset).shift(LOOKBACK_MONTHS)\n    prior_ym = ordered[\"ym\"].groupby(asset).shift(LOOKBACK_MONTHS)\n    value = (current - prior).where(ordered[\"ym\"].eq(prior_ym + LOOKBACK_MONTHS))\n    return value.reindex(frame.index)\n"
  },
  "research_spec": {
    "thesis": "Silver PIT current_assets/current_liabilities의 12개월 변화가 큰 종목은 이후 수익률 순위가 높을 것이다.",
    "mechanism": "단기 지급능력의 개선은 불리한 차환·증자 위험을 낮추며, 공시 후 점진적으로 가격에 반영될 수 있다.",
    "falsification": "무결성·커버리지·IC·강건성·BY·봉인 OOS·귀무·Gold 직교성 gate 중 하나라도 실패하면 기각한다.",
    "expected_relationship": "current_ratio 수준과 양의 관계를 예상하지만, 최근 12개월 개선폭만 측정하므로 정의상 구별된다.",
    "data_notes": "DART available_date PIT 유동자산과 양의 유동부채를 쓰며 정확히 12개월 전 비율이 있을 때만 정의한다.",
