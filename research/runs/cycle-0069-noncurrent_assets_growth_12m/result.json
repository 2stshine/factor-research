    },
    "rebalance_months": 3,
    "needs": [
      "noncurrent_assets"
    ],
    "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"])\n    asset = ordered[\"asset_id\"]\n    current = ordered[\"noncurrent_assets\"]\n    prior = current.groupby(asset).shift(LOOKBACK_MONTHS).where(lambda x: x > 0)\n    prior_ym = ordered[\"ym\"].groupby(asset).shift(LOOKBACK_MONTHS)\n    value = (current / prior - 1).where(ordered[\"ym\"].eq(prior_ym + LOOKBACK_MONTHS))\n    return value.reindex(frame.index)\n"
  },
  "research_spec": {
