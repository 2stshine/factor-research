    "params": {
      "window_months": 12,
      "lookback_months": 13
    },
    "rebalance_months": 1,
    "needs": [],
    "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"], kind=\"mergesort\")\n    grouped = ordered.groupby(\"asset_id\", sort=False)\n    monthly = ordered[\"adj_close\"] / grouped[\"adj_close\"].shift(1) - 1.0\n    lagged = monthly.groupby(ordered[\"asset_id\"], sort=False).shift(1)\n    products = monthly * lagged\n    value = products.groupby(ordered[\"asset_id\"], sort=False).rolling(WINDOW_MONTHS, min_periods=WINDOW_MONTHS).mean().reset_index(level=0, drop=True)\n    oldest_month = grouped[\"ym\"].shift(LOOKBACK_MONTHS)\n    return value.where(ordered[\"ym\"].eq(oldest_month + LOOKBACK_MONTHS)).reindex(frame.index)\n"
  },
  "research_spec": {
