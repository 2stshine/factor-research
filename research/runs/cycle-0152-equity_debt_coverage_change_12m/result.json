    "predicted_sign": 1,
    "params": {
      "lookback_months": 12
    },
    "rebalance_months": 3,
    "needs": [
      "total_equity",
      "total_liabilities"
    ],
    "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"], kind=\"mergesort\")\n    coverage = ordered[\"total_equity\"] / ordered[\"total_liabilities\"].where(ordered[\"total_liabilities\"] > 0)\n    prior = coverage.groupby(ordered[\"asset_id\"], sort=False).shift(LOOKBACK_MONTHS)\n    prior_month = ordered.groupby(\"asset_id\", sort=False)[\"ym\"].shift(LOOKBACK_MONTHS)\n    return (coverage - prior).where(ordered[\"ym\"].eq(prior_month + LOOKBACK_MONTHS)).reindex(frame.index)\n"
  },
