{"approval_sha256":"0aeef5632c89d79b982bc3bf362d037591df70cc22338b905b49b6d3d78b30ae","available_at":"2026-10-01T17:14:17+00:00","critic":{"checks":{"changed_scope_dimensions_reviewed":true,"no_performance_numbers":true,"no_result_based_candidate_tuning":true,"no_target_empirical_claim":true,"procedural_only":true,"research_time_not_signal_time":true,"source_citations_verified":true,"unknowns_and_limits_preserved":true},"decision":"ACCEPT","issues":[],"proposal_sha256":"1c07234d2f80ddc962309ef850808441ff7b3b0da7f5895b2e4bb905c67f6dc1","rationale":"새 제안 전체와 이전 제안의 차이를 읽고 승인된 영업 수익성 정성 원문의 해석·한계·후속 검사 제안에 다시 대조했다. 전달할 두 절차 문장과 원본의 관측을 새 효과로 옮기지 않는 한계는 그대로이며, 변경된 국면 계약 식별값을 포함한 대상 범위가 새 캠페인과 현재 동일 후보 파일에 정확히 결합된다. 측정 개념의 구분, 동일 표본 통제와 보유비용 검증의 분리, 표본 부족과 효과 부재의 구분은 원 교훈에 근거한다. 추가 문장은 평가 전 운영 코드 보완과 재동결의 경위를 기록할 뿐 성과에 맞춘 식·방향·기간 조정이나 새 실증 결과를 주장하지 않는다. 변경된 범위 차원의 이유와 미확인 업종·비용 경직성·경제적 매개, 가정된 국면, 과거 자료 재사용 및 연구시각 구분을 유지한다. 이번 승인도 해당 대상에서의 절차적 기억 사용에 한정하며 팩터 효과·인과·승격의 승인이 아니다.","reviewed_at":"2026-10-01T17:14:17+00:00","reviewer":"independent-production-integration-reviewer-cost-transfer-refreeze"},"economic_truth_certified":false,"proposal":{"author":"production-adoption-host","candidate_tuning_authorized":false,"changed_dimensions":{"cost_model":{"rationale":"원 교훈의 보유비용 미계산은 원 사례에만 해당한다. 새 연구의 월말 모의 비용 증거를 별도로 확인하며 월초 실제 체결과 구분한다.","source":"NO_VERIFIED_HOLDINGS_EXECUTION","target":"EXISTING_GATE_SEPARATE_EXECUTION_DIAGNOSTICS"},"data_snapshot":{"rationale":"원 사례의 표본 관측을 새 스냅샷의 실증 결과로 이전하지 않는다. 자료 버전이 달라도 측정 정의와 누락 근거를 명시하는 절차만 사용한다.","source":"3dfa8b07c6fe9eebd8c1c0fe4d7c95034763182ebf125be7935026d3bab2b3ba","target":"b04e1da89087f9c3799d81fad39589f9c2eae5bffab9e8fd4cd13ccfeecfeaa4"},"feature_definition":{"rationale":"영업 수익성과 영업비용 집약도는 다른 가설이다. 기존 양의 수익 관계를 옮기지 않고 동반 노출과 측정 개념을 구분하는 검사 설계만 참고한다.","source":"cedcb905fd41058ce01b86835e3903d0c9fa3a4c307ccd500516e6f1e7ba041f","target":"c3dae8030e39debc12f8bdafabd5d28140eee0f9004d673200d67492ccd8706f"},"information_lag":{"rationale":"원 범위에 없던 가용시각 차원을 명시한다. 현재 인증 특성 계약을 따르며 과거 최초 발표본이 추가 검증된 것으로 해석하지 않는다.","source":null,"target":"CERTIFIED_FEATURE_KNOWN_AT"},"period":{"rationale":"평가 시작월이 다른 표본에 원 결과를 재현한 것으로 적용하지 않는다. 새로운 범위의 관계는 자체 검사로만 판단한다.","source":"2016-02/2023-06","target":"2018-03/2023-06"},"protocol_version":{"rationale":"별도 파일럿과 운영 진단은 다른 절차다. 출처와 한계를 유지하고 실제 다음 검사 설계에만 참고한다.","source":"real-pilot-qualitative-release-v1","target":"production-research-v2-v1"},"regime_definition":{"rationale":"공통 코스피 문맥과 시장별 일간 위험 분류를 동일하게 보지 않는다. 표본 부족을 효과 부재로 해석하지 않는 원칙만 이전한다. 운영 코드 보완 뒤 동일 분류와 허용 기간을 새 캠페인에서 다시 동결했으며 후보의 성과는 아직 평가하지 않았다.","source":"d6dbd2fac32625bdf96131e9d125c5c0a1de9232f504e6c813e45bb320190e01","target":"a693291bccbdceebc307f12ee731d62d18d5adf5d4bcff259525f61bf79944fe"},"task_class":{"rationale":"새 단일 팩터의 진단 계획에 적용하는 절차적 기억이다. 과거 성과에 맞춘 식·방향·기간 변경이나 승인 근거로 사용하지 않는다.","source":null,"target":"NEW_SINGLE_FACTOR_RESEARCH"}},"limitations":["원 사례의 양의 수익성 관측과 국면 결과를 비용집약도 효과의 증거로 이전하지 않는다.","과거 구간과 기억의 재사용이며 독립 미래 검증이 아니다. 업종·비용 경직성·경제적 매개는 별도 근거가 없으면 미확인이다.","연구자가 지금 알게 된 교훈을 과거 매매 시점에 알려진 정보로 소급하지 않는다."],"proposed_at":"2026-10-01T17:13:42.823074+00:00","research_time_distinct_from_signal_time":true,"schema_version":"reviewed-memory-transfer-v1","source_content_sha256":"30dc39912e3860ef60e64d31c12072055341e4cac19d1584df153c0c94786e66","source_evidence_id":"qualitative:operating_roa:13bd4f2b90bc31b5919307e8ea3635c1e288f7bf3934beb293bd2a672f8c5761","source_payload_sha256":"11c931a78558291ff2503b7201f9c5ac4229aab3e833b5b6cc32a084d51e6c66","source_revision_id":"pilot-operating_roa@1","source_scope":{"cost_model":"NO_VERIFIED_HOLDINGS_EXECUTION","data_snapshot":"3dfa8b07c6fe9eebd8c1c0fe4d7c95034763182ebf125be7935026d3bab2b3ba","feature_definition":"cedcb905fd41058ce01b86835e3903d0c9fa3a4c307ccd500516e6f1e7ba041f","horizon":"ONE_MONTH_RETURN","market":"KOSPI_KOSDAQ","period":"2016-02/2023-06","pit_policy":"POLICY_BOUND_FEATURES_AND_PIT_ASSUMED_REGIME","protocol_version":"real-pilot-qualitative-release-v1","regime_definition":"d6dbd2fac32625bdf96131e9d125c5c0a1de9232f504e6c813e45bb320190e01","universe":"FROZEN_INVESTABLE_KRX_COMMON_STOCKS"},"statements":[{"kind":"PROCEDURAL_CAUTION","source_evidence_ids":["qualitative:operating_roa:13bd4f2b90bc31b5919307e8ea3635c1e288f7bf3934beb293bd2a672f8c5761"],"text":"경제적 결과의 수준·변화·현금흐름을 구분하고 가설과 맞지 않는 결과를 자동 대용하지 않는다. 비용 경직성을 직접 측정하지 못하면 원인을 미확인으로 남긴다."},{"kind":"TEST_DESIGN","source_evidence_ids":["qualitative:operating_roa:13bd4f2b90bc31b5919307e8ea3635c1e288f7bf3934beb293bd2a672f8c5761"],"text":"동일 표본의 기업 특성 통제와 보유·비용 검증을 별개 검사로 취급한다. 통제 뒤 남은 관계를 곧바로 고유한 경제적 원인이라고 부르지 않는다."}],"target_empirical_validation":"NOT_ESTABLISHED","target_scope":{"cost_model":"EXISTING_GATE_SEPARATE_EXECUTION_DIAGNOSTICS","data_snapshot":"b04e1da89087f9c3799d81fad39589f9c2eae5bffab9e8fd4cd13ccfeecfeaa4","feature_definition":"c3dae8030e39debc12f8bdafabd5d28140eee0f9004d673200d67492ccd8706f","horizon":"ONE_MONTH_RETURN","information_lag":"CERTIFIED_FEATURE_KNOWN_AT","market":"KOSPI_KOSDAQ","period":"2018-03/2023-06","pit_policy":"POLICY_BOUND_FEATURES_AND_PIT_ASSUMED_REGIME","protocol_version":"production-research-v2-v1","regime_definition":"a693291bccbdceebc307f12ee731d62d18d5adf5d4bcff259525f61bf79944fe","task_class":"NEW_SINGLE_FACTOR_RESEARCH","universe":"FROZEN_INVESTABLE_KRX_COMMON_STOCKS"}},"schema_version":"reviewed-memory-transfer-v1","target_scope":{"cost_model":"EXISTING_GATE_SEPARATE_EXECUTION_DIAGNOSTICS","data_snapshot":"b04e1da89087f9c3799d81fad39589f9c2eae5bffab9e8fd4cd13ccfeecfeaa4","feature_definition":"c3dae8030e39debc12f8bdafabd5d28140eee0f9004d673200d67492ccd8706f","horizon":"ONE_MONTH_RETURN","information_lag":"CERTIFIED_FEATURE_KNOWN_AT","market":"KOSPI_KOSDAQ","period":"2018-03/2023-06","pit_policy":"POLICY_BOUND_FEATURES_AND_PIT_ASSUMED_REGIME","protocol_version":"production-research-v2-v1","regime_definition":"a693291bccbdceebc307f12ee731d62d18d5adf5d4bcff259525f61bf79944fe","task_class":"NEW_SINGLE_FACT