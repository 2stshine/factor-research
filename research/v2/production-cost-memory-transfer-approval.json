{"approval_sha256":"f94f0833506f1af68d03ea573c1c4a0ae5787fc780cc532034e79b42ec021d31","available_at":"2026-10-01T16:53:53+00:00","critic":{"checks":{"changed_scope_dimensions_reviewed":true,"no_performance_numbers":true,"no_result_based_candidate_tuning":true,"no_target_empirical_claim":true,"procedural_only":true,"research_time_not_signal_time":true,"source_citations_verified":true,"unknowns_and_limits_preserved":true},"decision":"ACCEPT","issues":[],"proposal_sha256":"9e7cf8647a2a1967d1823c327733a8c274f8ede3603adbf105ea3d43053d850d","rationale":"승인된 영업 수익성 교훈의 정성 원문과 제안을 독립 대조했다. 측정 개념을 구분하고 통제와 보유비용 검사를 분리한다는 문장은 원 교훈의 해석과 후속 검사 제안에 직접 근거한다. 비용 경직성 미측정은 새 가설에 대한 절차적 한계이며 원 사례에서 관측된 비용 효과로 주장하지 않는다. 변경된 모든 범위 차원은 설명되어 있고 현재 후보 파일의 식별값과 대상 정의가 일치한다. 원 수익성 관측·국면 효과·인과·수익성을 새 후보에 이전하거나 방향·기간·수식을 성과에 맞추라는 처방이 없다. 원본의 미확인 업종·경제적 매개·보유비용, 가정된 국면과 최초 공개본 미검증, 과거 자료 재사용 한계가 보존된다. 이 승인은 절차적 기억의 해당 대상 전이만 허용하며 새 팩터 효과나 독립 검증을 승인하지 않는다.","reviewed_at":"2026-10-01T16:53:53+00:00","reviewer":"independent-production-integration-reviewer-cost-transfer"},"economic_truth_certified":false,"proposal":{"author":"production-adoption-host","candidate_tuning_authorized":false,"changed_dimensions":{"cost_model":{"rationale":"원 교훈의 보유비용 미계산은 원 사례에만 해당한다. 새 연구의 월말 모의 비용 증거를 별도로 확인하며 월초 실제 체결과 구분한다.","source":"NO_VERIFIED_HOLDINGS_EXECUTION","target":"EXISTING_GATE_SEPARATE_EXECUTION_DIAGNOSTICS"},"data_snapshot":{"rationale":"원 사례의 표본 관측을 새 스냅샷의 실증 결과로 이전하지 않는다. 자료 버전이 달라도 측정 정의와 누락 근거를 명시하는 절차만 사용한다.","source":"3dfa8b07c6fe9eebd8c1c0fe4d7c95034763182ebf125be7935026d3bab2b3ba","target":"b04e1da89087f9c3799d81fad39589f9c2eae5bffab9e8fd4cd13ccfeecfeaa4"},"feature_definition":{"rationale":"영업 수익성과 영업비용 집약도는 다른 가설이다. 기존 양의 수익 관계를 옮기지 않고 동반 노출과 측정 개념을 구분하는 검사 설계만 참고한다.","source":"cedcb905fd41058ce01b86835e3903d0c9fa3a4c307ccd500516e6f1e7ba041f","target":"c3dae8030e39debc12f8bdafabd5d28140eee0f9004d673200d67492ccd8706f"},"information_lag":{"rationale":"원 범위에 없던 가용시각 차원을 명시한다. 현재 인증 특성 계약을 따르며 과거 최초 발표본이 추가 검증된 것으로 해석하지 않는다.","source":null,"target":"CERTIFIED_FEATURE_KNOWN_AT"},"period":{"rationale":"평가 시작월이 다른 표본에 원 결과를 재현한 것으로 적용하지 않는다. 새로운 범위의 관계는 자체 검사로만 판단한다.","source":"2016-02/2023-06","target":"2018-03/2023-06"},"protocol_version":{"rationale":"별도 파일럿과 운영 진단은 다른 절차다. 출처와 한계를 유지하고 실제 다음 검사 설계에만 참고한다.","source":"real-pilot-qualitative-release-v1","target":"production-research-v2-v1"},"regime_definition":{"rationale":"공통 코스피 문맥과 시장별 일간 위험 분류를 동일하게 보지 않는다. 표본 부족을 효과 부재로 해석하지 않는 원칙만 이전한다.","source":"d6dbd2fac32625bdf96131e9d125c5c0a1de9232f504e6c813e45bb320190e01","target":"a48678de1e283d96086676bb1684fb7b400b52c76e09ec60b4a5cd030bc9d06e"},"task_class":{"rationale":"새 단일 팩터의 진단 계획에 적용하는 절차적 기억이다. 과거 성과에 맞춘 식·방향·기간 변경이나 승인 근거로 사용하지 않는다.","source":null,"target":"NEW_SINGLE_FACTOR_RESEARCH"}},"limitations":["원 사례의 양의 수익성 관측과 국면 결과를 비용집약도 효과의 증거로 이전하지 않는다.","과거 구간과 기억의 재사용이며 독립 미래 검증이 아니다. 업종·비용 경직성·경제적 매개는 별도 근거가 없으면 미확인이다.","연구자가 지금 알게 된 교훈을 과거 매매 시점에 알려진 정보로 소급하지 않는다."],"proposed_at":"2026-10-01T16:53:04.438593+00:00","research_time_distinct_from_signal_time":true,"schema_version":"reviewed-memory-transfer-v1","source_content_sha256":"30dc39912e3860ef60e64d31c12072055341e4cac19d1584df153c0c94786e66","source_evidence_id":"qualitative:operating_roa:13bd4f2b90bc31b5919307e8ea3635c1e288f7bf3934beb293bd2a672f8c5761","source_payload_sha256":"11c931a78558291ff2503b7201f9c5ac4229aab3e833b5b6cc32a084d51e6c66","source_revision_id":"pilot-operating_roa@1","source_scope":{"cost_model":"NO_VERIFIED_HOLDINGS_EXECUTION","data_snapshot":"3dfa8b07c6fe9eebd8c1c0fe4d7c95034763182ebf125be7935026d3bab2b3ba","feature_definition":"cedcb905fd41058ce01b86835e3903d0c9fa3a4c307ccd500516e6f1e7ba041f","horizon":"ONE_MONTH_RETURN","market":"KOSPI_KOSDAQ","period":"2016-02/2023-06","pit_policy":"POLICY_BOUND_FEATURES_AND_PIT_ASSUMED_REGIME","protocol_version":"real-pilot-qualitative-release-v1","regime_definition":"d6dbd2fac32625bdf96131e9d125c5c0a1de9232f504e6c813e45bb320190e01","universe":"FROZEN_INVESTABLE_KRX_COMMON_STOCKS"},"statements":[{"kind":"PROCEDURAL_CAUTION","source_evidence_ids":["qualitative:operating_roa:13bd4f2b90bc31b5919307e8ea3635c1e288f7bf3934beb293bd2a672f8c5761"],"text":"경제적 결과의 수준·변화·현금흐름을 구분하고 가설과 맞지 않는 결과를 자동 대용하지 않는다. 비용 경직성을 직접 측정하지 못하면 원인을 미확인으로 남긴다."},{"kind":"TEST_DESIGN","source_evidence_ids":["qualitative:operating_roa:13bd4f2b90bc31b5919307e8ea3635c1e288f7bf3934beb293bd2a672f8c5761"],"text":"동일 표본의 기업 특성 통제와 보유·비용 검증을 별개 검사로 취급한다. 통제 뒤 남은 관계를 곧바로 고유한 경제적 원인이라고 부르지 않는다."}],"target_empirical_validation":"NOT_ESTABLISHED","target_scope":{"cost_model":"EXISTING_GATE_SEPARATE_EXECUTION_DIAGNOSTICS","data_snapshot":"b04e1da89087f9c3799d81fad39589f9c2eae5bffab9e8fd4cd13ccfeecfeaa4","feature_definition":"c3dae8030e39debc12f8bdafabd5d28140eee0f9004d673200d67492ccd8706f","horizon":"ONE_MONTH_RETURN","information_lag":"CERTIFIED_FEATURE_KNOWN_AT","market":"KOSPI_KOSDAQ","period":"2018-03/2023-06","pit_policy":"POLICY_BOUND_FEATURES_AND_PIT_ASSUMED_REGIME","protocol_version":"production-research-v2-v1","regime_definition":"a48678de1e283d96086676bb1684fb7b400b52c76e09ec60b4a5cd030bc9d06e","task_class":"NEW_SINGLE_FACTOR_RESEARCH","universe":"FROZEN_INVESTABLE_KRX_COMMON_STOCKS"}},"schema_version":"reviewed-memory-transfer-v1","target_scope":{"cost_model":"EXISTING_GATE_SEPARATE_EXECUTION_DIAGNOSTICS","data_snapshot":"b04e1da89087f9c3799d81fad39589f9c2eae5bffab9e8fd4cd13ccfeecfeaa4","feature_definition":"c3dae8030e39debc12f8bdafabd5d28140eee0f9004d673200d67492ccd8706f","horizon":"ONE_MONTH_RETURN","information_lag":"CERTIFIED_FEATURE_KNOWN_AT","market":"KOSPI_KOSDAQ","period":"2018-03/2023-06","pit_policy":"POLICY_BOUND_FEATURES_AND_PIT_ASSUMED_REGIME","protocol_version":"production-research-v2-v1","regime_definition":"a48678de1e283d96086676bb1684fb7b400b52c76e09ec60b4a5cd030bc9d06e","task_class":"NEW_SINGLE_FACTOR_RESEARCH","universe":"FROZEN_INVESTABLE_KRX_COMMON_STOCKS"},"transfer_type":"PROCEDURAL_ONLY_NOT_TARGET_EVIDENCE"}
