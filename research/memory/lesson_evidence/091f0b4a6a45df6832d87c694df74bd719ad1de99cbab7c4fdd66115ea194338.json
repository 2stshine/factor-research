    {
      "data": {
        "data_notes": "DART available_date PIT 자기자본과 동월 Silver 시가총액을 사용한다. 현재·12개월 전 시가총액이 양수이고 정확한 달력 간격이 있을 때만 계산한다.",
        "expected_relationship": "가장 가까운 기존 팩터: value_bp — 차이: 장부가치/시가총액의 절대 수준이 아니라 정확한 12개월 변화만 측정한다.",
        "falsification": "양의 방향, 투자 가능 IC, 강건성, BY, 기존 가치·반전 신호 직교성 또는 봉인 OOS가 실패하면 가설을 기각한다.",
        "hypothesis": "PIT 자기자본/시가총액 비율의 12개월 증가폭이 큰 종목은 다음 달 총수익률 순위가 높을 것이다.",
        "inputs": [
          "total_equity"
        ],
        "mechanism": "시장가격 하락 또는 장부가치 개선에 대한 과잉·지연 반응은 가치 괴리를 만들고 이후 재평가로 해소될 수 있다.",
        "params": {
          "lookback_months": 12
        },
        "research_spec": {
          "data_notes": "DART available_date PIT 자기자본과 동월 Silver 시가총액을 사용한다. 현재·12개월 전 시가총액이 양수이고 정확한 달력 간격이 있을 때만 계산한다.",
          "expected_relationship": "가장 가까운 기존 팩터: value_bp — 차이: 장부가치/시가총액의 절대 수준이 아니라 정확한 12개월 변화만 측정한다.",
          "factor_name": "book_to_market_change_12m",
          "falsification": "양의 방향, 투자 가능 IC, 강건성, BY, 기존 가치·반전 신호 직교성 또는 봉인 OOS가 실패하면 가설을 기각한다.",
          "max_lookback_months": 12,
          "mechanism": "시장가격 하락 또는 장부가치 개선에 대한 과잉·지연 반응은 가치 괴리를 만들고 이후 재평가로 해소될 수 있다.",
          "strategy_file": "factors/candidates/book_to_market_change_12m.py",
          "strategy_sha256": "fab600c894efe365a664ceaf6971636cc18e22553c23f7c4d8a0f710755cd0c6",
          "thesis": "PIT 자기자본/시가총액 비율의 12개월 증가폭이 큰 종목은 다음 달 총수익률 순위가 높을 것이다."
        },
        "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"], kind=\"mergesort\")\n    grouped = ordered.groupby(\"asset_id\", sort=False)\n    current = ordered[\"total_equity\"] / ordered[\"market_cap\"].where(\n        ordered[\"market_cap\"] > 0\n    )\n    prior_equity = grouped[\"total_equity\"].shift(LOOKBACK_MONTHS)\n    prior_market_cap = grouped[\"market_cap\"].shift(LOOKBACK_MONTHS)\n    prior_month = grouped[\"ym\"].shift(LOOKBACK_MONTHS)\n    prior = prior_equity / prior_market_cap.where(prior_market_cap > 0)\n    return (current - prior).where(\n        ordered[\"ym\"].eq(prior_month + LOOKBACK_MONTHS)\n    ).reindex(frame.index)\n"
      },
      "id": "hypothesis",
      "kind": "PREREGISTERED_CLAIM_NOT_FACT"
    },
