          "numerator": "revenue_ttm"
        },
        "research_spec": {
          "data_notes": "PIT revenue_ttm·total_liabilities와 동시점 market_cap, 정확한 달력 시차만 사용한다.",
          "expected_relationship": "기존 가치 수준과 관련될 수 있으나 매출/기업가치의 변화로 Gold 0.70 사전검사를 요구한다.",
