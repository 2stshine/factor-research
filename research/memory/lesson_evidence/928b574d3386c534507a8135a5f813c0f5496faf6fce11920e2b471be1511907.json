          "factor_name": "trading_value_volatility_12m",
          "falsification": "자동 gate, BY, 봉인 OOS, 귀무 또는 거래활동 신호 직교성이 실패하면 기각한다.",
          "max_lookback_months": 12,
          "mechanism": "간헐적 거래 급증은 안정적 유동성보다 투기적 관심과 가격충격 위험을 나타낸다.",
          "strategy_file": "factors/candidates/trading_value_volatility_12m.py",
          "strategy_sha256": "2b9c8dde368c1c1ab2393d96597d7a0c1427ccee7006bf84495316530fbe0b04",
          "thesis": "12개월 거래대금/시가총액 표준편차가 높은 종목의 이후 순위가 낮을 것이다."
        },
        "source": "def compute(frame):\n    ordered = frame.sort_values([\"asset_id\", \"ym\"], kind=\"mergesort\")\n    scaled = ordered[\"trading_value\"] / ordered[\"market_cap\"].where(ordered[\"market_cap\"] > 0)\n    grouped = scaled.groupby(ordered[\"asset_id\"], sort=False)\n    value = grouped.rolling(WINDOW_MONTHS, min_periods=WINDOW_MONTHS).std().reset_index(level=0, drop=True)\n    oldest_month = ordered.groupby(\"asset_id\", sort=False)[\"ym\"].shift(WINDOW_MONTHS - 1)\n    return value.where(ordered[\"ym\"].eq(oldest_month + WINDOW_MONTHS - 1)).reindex(frame.index)\n"
      },
