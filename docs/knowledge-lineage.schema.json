{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-lineage-v1",
  "title": "Future qualitative knowledge-use declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_snapshot_hash",
    "snapshot_captured_at",
    "declared_at",
    "referenced_lesson_record_ids",
    "lesson_references"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-lineage-v1"
    },
    "knowledge_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    },
    "referenced_lesson_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lesson_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "review_hash",
          "packet_sha256",
          "relation"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "review_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relation": {
            "enum": [
              "DECLARED_QUALITATIVE_LESSON_USE",
              "DECLARED_COMPARISON_REFERENCE"
            ]
          }
        }
      }
    }
  }
}
